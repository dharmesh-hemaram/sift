{
  "manifest_version": 3,
  "name": "Sift",
  "short_name": "Sift",
  "version": "0.1.0",
  "description": "Filter, map, and combine API response data inline in Chrome DevTools — no code required.",
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
